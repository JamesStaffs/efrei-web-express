{
  "name": "pet-store-repository-example",
  "version": "1.0.0",
  "private": true,
  "description": "Express and TypeScript pet store demonstrating the repository pattern with SQLite",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
